CRYPTO_BASKET=ETH-EUR,BTC-EUR,PHA-EUR,NIL-EUR,WLD-EUR,PEPE-EUR,ARB-EUR,DOT-EUR,DOS-EUR,UP-EUR,KAT-EUR,ACU-EUR,IRYS-EUR,BIRB-EUR,ENA-EUR,XRP-EUR,SOL-EUR,ICNT-EUR,TREE-EUR
# Optionnel : solde réel (mode ombre) avec une clé au seul droit « Consulter » ; mode réel avec
# une clé « Consulter » + « Trader », jamais « Retirer ».
BITVAVO_API_KEY=
BITVAVO_API_SECRET=
# Mode réel (ordres envoyés à Bitvavo) : double verrou. Sans PRODUCTION_LIVE=1 et un plafond de
# capital engagé, le bouton du dashboard reste inactif. Recréer le moteur après modification :
# docker compose up -d engine
PRODUCTION_LIVE=0
PRODUCTION_MAX_CAPITAL=
# Identifiant du moteur auprès de Bitvavo (operatorId, obligatoire sur les ordres).
BITVAVO_OPERATOR_ID=1
DB_PATH=data/mcs.sqlite
# WAL (défaut, production sur disque local) ou DELETE (développement : base sur le partage SMB du NAS,
# où WAL n'est pas fiable).
SQLITE_JOURNAL_MODE=DELETE
LOG_DIR=logs
# Frais Bitvavo en fraction (0.0015 = 0,15 %), à ajuster selon votre palier.
FEE_MAKER=0.0015
FEE_TAKER=0.0025
# Cœurs utilisés par l'optimisation lancée depuis le dashboard.
OPTIMIZER_WORKERS=4
